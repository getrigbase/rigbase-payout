# Path to the admin wallet JSON ({ "address", "privateKey" }). Keep it OUTSIDE the repo.
WALLET_FILE=/path/outside/repo/rigbase-celo-wallet.json
# Path where the agent's session key is generated/stored. Keep it OUTSIDE the repo.
SESSION_KEY_FILE=/path/outside/repo/rigbase-session-key.json
# Celo mainnet RPC
CELO_RPC_URL=https://forno.celo.org
# Loops-issued attribution code (ERC-8021). Every tx carries it.
ATTRIBUTION_CODE=celo_f41eab517821
# Set to 1 to allow broadcasting. Anything else = dry run.
LIVE=0
